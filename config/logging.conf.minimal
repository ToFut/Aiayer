[loggers]
keys=root,sensors,llm,agent,ui,memory,websocket,bridge

[handlers]
keys=consoleHandler,errorFileHandler,criticalFileHandler

[formatters]
keys=simpleFormatter,detailedFormatter

[logger_root]
level=WARNING
handlers=consoleHandler,errorFileHandler
propagate=0

[logger_sensors]
level=WARNING
handlers=consoleHandler,errorFileHandler
qualname=sensors
propagate=0

[logger_llm]
level=WARNING
handlers=consoleHandler,errorFileHandler
qualname=llm
propagate=0

[logger_agent]
level=WARNING
handlers=consoleHandler,errorFileHandler
qualname=agent
propagate=0

[logger_ui]
level=WARNING
handlers=consoleHandler,errorFileHandler
qualname=ui
propagate=0

[logger_memory]
level=ERROR
handlers=consoleHandler,errorFileHandler
qualname=memory
propagate=0

[logger_websocket]
level=ERROR
handlers=consoleHandler,errorFileHandler
qualname=websocket
propagate=0

[logger_bridge]
level=ERROR
handlers=consoleHandler,errorFileHandler
qualname=bridge
propagate=0

[handler_consoleHandler]
class=StreamHandler
level=WARNING
formatter=simpleFormatter
args=(sys.stdout,)

[handler_errorFileHandler]
class=handlers.RotatingFileHandler
level=ERROR
formatter=detailedFormatter
args=('logs/error.log', 'a', 5242880, 3)

[handler_criticalFileHandler]
class=handlers.RotatingFileHandler
level=CRITICAL
formatter=detailedFormatter
args=('logs/critical.log', 'a', 5242880, 3)

[formatter_simpleFormatter]
format=%(asctime)s - %(name)s - %(levelname)s - %(message)s
datefmt=%H:%M:%S

[formatter_detailedFormatter]
format=%(asctime)s - %(name)s - %(levelname)s - %(filename)s:%(lineno)d - %(message)s
datefmt=%Y-%m-%d %H:%M:%S