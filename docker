FROM python:3.10-slim

LABEL maintainer="AI Assistant Developer <developer@example.com>"
LABEL description="Local AI Assistant with privacy-focused design"
LABEL version="0.1.0"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libtesseract-dev \
    tesseract-ocr-eng \
    curl \
    gnupg \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements.txt first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create directory structure
RUN mkdir -p /root/.local_assistant/knowledge

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FLASK_APP=ui.chat_server:app \
    DOCKER_ENV=true

# Expose the port for the web interface
EXPOSE 5000

# Set up healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5000/ || exit 1

# Entry point - Start the assistant
CMD ["python", "main.py"]