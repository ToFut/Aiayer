[Unit]
Description=Aiayer Local AI Assistant
Documentation=https://github.com/sensai/aiayer
After=network.target
Wants=network.target

[Service]
Type=simple
User=aiayer
Group=aiayer
WorkingDirectory=/opt/aiayer
Environment=PATH=/opt/aiayer/venv/bin
ExecStart=/opt/aiayer/venv/bin/python /opt/aiayer/main.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiayer

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aiayer/logs /opt/aiayer/cache /opt/aiayer/memory /opt/aiayer/config

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Environment variables
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target 