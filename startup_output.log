🧪 Test Enhanced Contextual Responses:
   python3 -c "
import asyncio, websockets, json
async def test_enhanced():
    async with websockets.connect('ws://localhost:8767') as ws:
        await ws.recv()  # connection msg
        await ws.send(json.dumps({'type': 'chat_request', 'mode': 'ask', 'message': 'what am I seeing?'}))
        responses = []
        while True:
            msg = await ws.recv()
            data = json.loads(msg)
            if data.get('type') == 'chat_response':
                responses.append(data.get('content', ''))
            elif data.get('type') == 'chat_complete':
                break
        print(''.join(responses))
asyncio.run(test_enhanced())
"

